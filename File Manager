    print('\t\t\t\t\t\t|~~~~~~~~~~~~~~~~~~~~~~~~~|')

    print('\n\nA = Create File')
    print('B = Open File')
    print('C = EXIT')

    operation = input('\nEnter The Operation You Want To Perform --> ')

    if operation.upper() == 'A':

        createproject()

