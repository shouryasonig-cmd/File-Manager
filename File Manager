        print('\n\n~ Open File ~')

        print('\nA = Read')
        print('B = Wipe And Write')
        print('C = Update')
        print('D = EXIT')

        operation = input('\nEnter The Operation You Want To Perform --> ')

        if operation.upper() == 'A':

            read()

        elif operation.upper() == 'B':

